      "ports": [
        {
          "name": "http",
          "port": 80,
          "protocol": "TCP",
          "targetPort": "http"
        }
      ],
      "selector": {
        "app": "web"
      }
    }
  },
  "pods": [
    {
      "apiVersion": "v1",
      "kind": "Pod",
      "metadata": {
        "labels": {
          "app": "web"
        },
        "name": "web-a",
        "namespace": "demo",
        "uid": "pod-a"
      },
      "status": {
        "conditions": [
          {
            "status": "True",
            "type": "Ready"
          }
        ],
        "podIP": "10.244.1.10"
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Pod",
      "metadata": {
        "labels": {
          "app": "web"
        },
        "name": "web-b",
        "namespace": "demo",
        "uid": "pod-b"
      },
      "status": {
        "conditions": [
          {
            "status": "False",
            "type": "Ready"
          }
        ],
        "podIP": "10.244.2.11"
      }
    },
    {
      "apiVersion": "v1",
