      "metadata": {
        "labels": {
          "app": "worker"
        },
        "name": "worker",
        "namespace": "demo",
        "uid": "pod-worker"
      },
      "status": {
        "podIP": "10.244.1.20"
      }
    }
  ],
  "endpointSlices": [
